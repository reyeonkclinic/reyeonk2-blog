<!doctype html>
<html lang="{{ lang or metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="naver-site-verification" content="7cff2151065b2f9f7592e981546783c145cb7802">
		<meta name="google-site-verification" content="BCFQN-9aVxyw5kSnKHXb0Jh5-JGXF3xO_t7utU01jn8">
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		{%- set pageUrl = page.url | htmlBaseUrl(metadata.url) %}
		{%- set ogImage = (image or "/img/og/default.jpg") | htmlBaseUrl(metadata.url) %}
		<link rel="canonical" href="{{ pageUrl }}">
		{%- for a in alternates %}
		<link rel="alternate" hreflang="{{ a.lang }}" href="{{ a.url | htmlBaseUrl(metadata.url) }}">
		{%- endfor %}
		<meta property="og:type" content="{% if tags and ("posts" in tags) %}article{% else %}website{% endif %}">
		<meta property="og:site_name" content="{{ metadata.title }}">
		<meta property="og:locale" content="{% if lang == "en" %}en_US{% else %}ko_KR{% endif %}">
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ description or metadata.description }}">
		<meta property="og:url" content="{{ pageUrl }}">
		<meta property="og:image" content="{{ ogImage }}">
		<meta name="twitter:card" content="summary_large_image">
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<script type="application/ld+json" eleventy:ignore>
		{
			"@context": "https://schema.org",
			"@type": "MedicalClinic",
			"@id": "https://reyeonk2.com/#clinic",
			"name": "리연케이의원",
			"alternateName": ["리연케이클리닉", "ReyeonK Clinic"],
			"description": "압구정로데오역 인근 리프팅·스킨케어·쁘띠 시술 클리닉. 2009년 개원, 원장 직접 상담·시술.",
			"url": "https://reyeonk.co.kr",
			"image": "https://reyeonk2.com/img/og/default.jpg",
			"telephone": "+82-2-558-5581",
			"foundingDate": "2009",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "언주로172길 64 리연케이빌딩",
				"addressLocality": "강남구",
				"addressRegion": "서울특별시",
				"addressCountry": "KR"
			},
			"openingHoursSpecification": [
				{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Thursday"], "opens": "10:00", "closes": "20:00" },
				{ "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "10:00", "closes": "19:00" },
				{ "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "15:00" }
			],
			"sameAs": [
				"https://reyeonk.co.kr",
				"https://reyeonk2.com",
				"https://pf.kakao.com/_MTfIxd",
				"https://reyeonkbeauty.blogspot.com",
				"https://reyeonkclinic.blogspot.com",
				"https://beyondto1.tistory.com",
				"https://rk-lifting.tistory.com",
				"https://blog.naver.com/rek_chang"
			]
		}
		</script>

		{#- Uncomment this if you’d like folks to know that you used Eleventy to build your site!  #}
		{#- <meta name="generator" content="{{ eleventy.generator }}"> #}

		{#-
		Plain-text bundles are provided via the `eleventy-plugin-bundle` plugin:
		1. CSS:
			* Add to a per-page bundle using `{% css %}{% endcss %}`
			* Retrieve bundle content using `{% getBundle "css" %}` or `{% getBundleFileUrl "css" %}`
		2. Or for JavaScript:
			* Add to a per-page bundle using `{% js %}{% endjs %}`
			* Retrieve via `{% getBundle "js" %}` or `{% getBundleFileUrl "js" %}`
		3. Learn more: https://github.com/11ty/eleventy-plugin-bundle
		#}

		{#- Add CSS to the bundle #}
		<style>/* This is an arbitrary CSS string added to the bundle */</style>

		{#- Add the contents of a file to the bundle #}
		<style>{% include "css/index.css" %}</style>

		{#- Or you can add from node_modules #}
		{# <style>{% include "node_modules/something.css" %}</style> #}

		{#- Render the CSS bundle using inlined CSS (for the fastest site performance in production) #}
		<style>{% getBundle "css" %}</style>

		{#- Renders the CSS bundle using a separate file, if you can't set CSP directive style-src: 'unsafe-inline' #}
		{#- <link rel="stylesheet" href="{% getBundleFileUrl "css" %}"> #}

		{#- Add the heading-anchors web component to the JavaScript bundle #}
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body>
		<a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

		<header>
			<a href="{% if lang == "en" %}/en/{% else %}/{% endif %}" class="home-link">{% if lang == "en" %}Reyeonk Clinic{% else %}{{ metadata.title }}{% endif %}</a>

			{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
			<nav>
				<h2 class="visually-hidden">Top level navigation menu</h2>
				<ul class="nav">
				{%- if lang == "en" %}
					<li class="nav-item"><a href="/en/"{% if page.url == "/en/" %} aria-current="page"{% endif %}>Home</a></li>
					<li class="nav-item"><a href="/en/doctors/"{% if page.url == "/en/doctors/" %} aria-current="page"{% endif %}>Doctors</a></li>
					<li class="nav-item"><a href="/en/location/"{% if page.url == "/en/location/" %} aria-current="page"{% endif %}>Location</a></li>
					<li class="nav-item"><a href="/" hreflang="ko" lang="ko">한국어</a></li>
				{%- else %}
				{%- for entry in collections.all | eleventyNavigation %}
					<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
				{%- endfor %}
				{%- endif %}
				</ul>
			</nav>
		</header>

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer>
			{%- if lang == "en" %}
			<p>
				<strong>Reyeonk Clinic</strong> · 64 Eonju-ro 172-gil, Gangnam-gu, Seoul (Reyeonk Building) · <a href="tel:+82-2-558-5581">+82-2-558-5581</a><br>
				Mon, Tue, Thu 10:00–20:00 · Fri 10:00–19:00 · Sat 10:00–15:00 · Closed Wed, Sun and public holidays · <a href="https://reyeonk.co.kr" target="_blank" rel="noopener">reyeonk.co.kr</a>
			</p>
			{%- else %}
			<p>
				<strong>리연케이의원</strong> · 서울특별시 강남구 언주로172길 64 리연케이빌딩 · <a href="tel:025585581">02-558-5581</a><br>
				월·화·목 10–20시 · 금 10–19시 · 토 10–15시 · 수·일·공휴일 휴진 · <a href="https://reyeonk.co.kr" target="_blank" rel="noopener">reyeonk.co.kr</a>
			</p>
					{%- endif %}
		</footer>

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
