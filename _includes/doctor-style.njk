<style>
.dr { word-break: keep-all; line-height: 1.75; }
.dr-lead { color: #5A6B68; max-width: 36rem; }
.dr-grid { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.dr-card { border: 1px solid #D3DDDA; padding: 20px; display: grid; gap: 6px; align-content: start; }
.dr-card a { text-decoration: none; color: inherit; display: grid; gap: 6px; }
.dr-role { color: #1D6B66; font-weight: 600; font-size: 0.9rem; }
.dr-name { font-size: 1.35rem; font-weight: 700; margin: 0; }
.dr-quote { font-style: normal; color: #5A6B68; }
.dr-focus { font-size: 0.9rem; background: #DDECE9; padding: 4px 10px; width: fit-content; color: #14211F; }
.dr-more { color: #1D6B66; font-weight: 600; font-size: 0.92rem; margin-top: 6px; }
.dr-head { margin-bottom: 24px; }
.dr-head blockquote { margin: 16px 0 0; padding-left: 14px; border-left: 3px solid #1D6B66; font-size: 1.15rem; font-weight: 600; }
.dr-block { margin-top: 28px; }
.dr-block h2 { font-size: 1.15rem; }
.dr-block ul { padding-left: 1.2em; }
.dr-nav { margin-top: 36px; padding-top: 20px; border-top: 1px solid #D3DDDA; display: flex; flex-wrap: wrap; gap: 8px 18px; }
.dr-photo { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; margin-bottom: 8px; background: #DDECE9; }
.dr-top { display: grid; grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: 28px; align-items: start; }
.dr-portrait { display: block; width: 100%; height: auto; background: #DDECE9; }
@media (max-width: 640px) { .dr-top { grid-template-columns: 1fr; } .dr-portrait { max-width: 320px; } }
@media (prefers-color-scheme: dark) {
	.dr-lead, .dr-quote { color: #9AAEAA; }
	.dr-card, .dr-nav { border-color: #273936; }
	.dr-role, .dr-more { color: #6CC3BB; }
	.dr-focus { background: #1B3431; color: #E4EEEC; }
	.dr-head blockquote { border-color: #6CC3BB; }
}
@media (max-width: 640px) { .dr-grid { grid-template-columns: 1fr; } }
</style>
