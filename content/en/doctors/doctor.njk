---js
const pagination = { data: "doctorsEn", size: 1, alias: "d" };
const permalink = (data) => `/en/doctors/${data.d.slug}/`;
const lang = "en";
const eleventyComputed = {
	title: (data) => `${data.d.name}, ${data.d.title} | Reyeonk Clinic (${data.d.focus})`,
	description: (data) => `${data.d.name}, ${data.d.title} at Reyeonk Clinic in Apgujeong, Seoul. ${data.d.intro}`,
	alternates: (data) => [
		{ lang: "ko", url: `/doctors/${data.d.slug}/` },
		{ lang: "en", url: `/en/doctors/${data.d.slug}/` },
		{ lang: "ja", url: `/ja/doctors/${data.d.slug}/` },
		{ lang: "x-default", url: `/doctors/${data.d.slug}/` }
	]
};
---
{% include "doctor-style.njk" %}
<div class="dr" style="word-break: normal">
	<p class="dr-lang"><a href="/doctors/{{ d.slug }}/" hreflang="ko" lang="ko">한국어</a> · <strong>English</strong></p>
	<div class="dr-top">
	{% if d.photo %}<img class="dr-portrait" src="{{ d.photo }}" alt="Reyeonk Clinic {{ d.name }}, {{ d.title }}" width="{{ d.photoSize[0] }}" height="{{ d.photoSize[1] }}" loading="eager" eleventy:ignore>{% endif %}
	<div class="dr-head">
		<p class="dr-role">Reyeonk Clinic · {{ d.title }}</p>
		<h1>{{ d.name }}</h1>
		<blockquote>{{ d.quote }}</blockquote>
		<p class="dr-lead" style="margin-top: 16px">{{ d.intro }}</p>
		<p class="dr-focus" style="margin-top: 12px">{{ d.focus }}</p>
	</div>
	</div>
	{%- if d.career.length %}
	<section class="dr-block"><h2>Career</h2><ul>{% for c in d.career %}<li>{{ c }}</li>{% endfor %}</ul></section>
	{%- endif %}
	{%- if d.training.length %}
	<section class="dr-block"><h2>Training and certifications</h2><ul>{% for c in d.training %}<li>{{ c }}</li>{% endfor %}</ul></section>
	{%- endif %}
	{%- if d.societies.length %}
	<section class="dr-block"><h2>Professional societies</h2><ul>{% for c in d.societies %}<li>{{ c }}</li>{% endfor %}</ul></section>
	{%- endif %}
	<section class="dr-block">
		<h2>Consultations</h2>
		<p>Phone <a href="tel:+82-2-558-5581">+82-2-558-5581</a> · <a href="/en/location/">Getting here</a> · <a href="{{ d.official }}" target="_blank" rel="noopener">Official profile (Korean)</a></p>
		<p>Treatment plans are decided at an in-person consultation. Results and suitability differ from person to person.</p>
	</section>
	<nav class="dr-nav" aria-label="Other doctors">
		<a href="/en/doctors/">All doctors</a>
		{%- for o in doctorsEn %}{% if o.slug != d.slug %}<a href="/en/doctors/{{ o.slug }}/">{{ o.name }}</a>{% endif %}{% endfor %}
	</nav>
</div>
<script type="application/ld+json" eleventy:ignore>
{
	"@context": "https://schema.org",
	"@type": "Physician",
	"name": "{{ d.name }}",
	"jobTitle": "{{ d.title }}",
	{% if d.photo %}"image": "https://reyeonk2.com{{ d.photo }}",{% endif %}
	"url": "https://reyeonk2.com/en/doctors/{{ d.slug }}/",
	"sameAs": ["{{ d.official }}"],
	"worksFor": { "@id": "https://reyeonk2.com/#clinic", "@type": "MedicalClinic", "name": "Reyeonk Clinic" },
	"telephone": "+82-2-558-5581",
	"address": { "@type": "PostalAddress", "streetAddress": "64 Eonju-ro 172-gil, Reyeonk Building", "addressLocality": "Gangnam-gu", "addressRegion": "Seoul", "addressCountry": "KR" }
}
</script>
