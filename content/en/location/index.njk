---js
const permalink = "/en/location/";
const lang = "en";
const title = "Getting Here | Reyeonk Clinic (Apgujeong Rodeo Station Exit 6)";
const description = "How to get to Reyeonk Clinic in Apgujeong, Seoul. By subway, walk from Exit 6 of Apgujeong Rodeo Station (Suin-Bundang Line). By car, use valet parking at the Reyeonk Building lot (Sinsa-dong 662-12). Check in on the 3rd floor.";
const image = "/img/og/location.jpg";
const alternates = [
	{ lang: "ko", url: "/location/" },
	{ lang: "en", url: "/en/location/" },
	{ lang: "ja", url: "/ja/location/" },
	{ lang: "zh-Hans", url: "/zh/location/" },
	{ lang: "x-default", url: "/location/" }
];
---
<style>
.lc { line-height: 1.7; }
.lc-lang { font-size: 0.9rem; margin: 0 0 12px; }
.lc-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 28px; }
.lc-tabs a { padding: 8px 16px; border: 1px solid currentColor; text-decoration: none; font-weight: 600; }
.lc-sec { margin-top: 40px; padding-top: 32px; border-top: 1px solid #D3DDDA; }
.lc-sec:first-of-type { border-top: 0; padding-top: 0; margin-top: 0; }
.lc ol, .lc ul { padding-left: 1.3em; }
.lc figure { margin: 24px 0 0; }
.lc figure img { display: block; width: 100%; max-width: 460px; height: auto; margin: 0 auto; }
.lc figcaption { text-align: center; font-size: 0.9rem; margin-top: 8px; color: #5A6B68; }
.lc-note { padding: 14px 16px; background: #DDECE9; color: #14211F; font-weight: 600; margin-top: 16px; }
@media (prefers-color-scheme: dark) { .lc-note { background: #1B3431; color: #E4EEEC; } .lc-sec { border-color: #273936; } .lc figcaption { color: #9AAEAA; } }
</style>

<div class="lc">
<p class="lc-lang"><a href="/location/" hreflang="ko" lang="ko">한국어</a> · <strong>English</strong></p>
<h1>Getting to Reyeonk Clinic</h1>
<p>Reyeonk Building, 64 Eonju-ro 172-gil, Gangnam-gu, Seoul (Sinsa-dong 663-20)<br>Phone <a href="tel:+82-2-558-5581">+82-2-558-5581</a></p>
<p class="lc-note">Please check in on the 3rd floor.</p>
<nav class="lc-tabs" aria-label="Choose how you are traveling">
	<a href="#subway">By subway</a>
	<a href="#car">By car and parking</a>
</nav>

<section class="lc-sec" id="subway">
	<h2>By subway</h2>
	<p>The nearest station is <strong>Apgujeong Rodeo Station</strong> on the Suin-Bundang Line, and <strong>Exit 6</strong> is the quickest way out.</p>
	<ol>
		<li>Get off at Apgujeong Rodeo Station and take Exit 6.</li>
		<li>Walk straight about 10 m to the entrance of the alley.</li>
		<li>Turn left into the alley next to the 7-Eleven.</li>
		<li>Go straight for three blocks (about 50 m).</li>
		<li>Turn right into the alley between the GS25 stores and walk straight 8 m.</li>
		<li>You have arrived at Reyeonk. Check in on the 3rd floor.</li>
	</ol>
	<p>By bus, get off at the Galleria Department Store stop (routes 143, 301, 362, 472 and others).</p>
	<figure><img src="./img/subway.jpg" alt="Walking directions from Apgujeong Rodeo Station Exit 6 to Reyeonk Clinic: walk 10 m straight, turn left at the alley next to the 7-Eleven, go straight three blocks, turn right into the alley between the GS25 stores and walk 8 m. Check in on the 3rd floor." width="423" height="2576"><figcaption>The text in this map is in Korean. The steps above describe the same route.</figcaption></figure>
</section>

<section class="lc-sec" id="car">
	<h2>By car and parking</h2>
	<ul>
		<li><strong>Parking lot</strong>: Reyeonk Building parking lot</li>
		<li><strong>Address</strong>: Sinsa-dong 662-12, Gangnam-gu, Seoul</li>
		<li><strong>Parking lot phone</strong>: <a href="tel:+82-2-545-1933">+82-2-545-1933</a></li>
		<li><strong>Fee</strong>: 5,000 KRW for the first 2 hours (with the parking stamp applied)</li>
	</ul>
	<ol>
		<li>In your navigation app, search for "리연케이빌딩 주차장" or "서울 강남구 신사동 662-12" and set off.</li>
		<li>When you arrive at the lot, use valet parking.</li>
		<li>After parking, walk diagonally across to the Reyeonk Building.</li>
		<li>You have arrived at Reyeonk. Check in on the 3rd floor.</li>
	</ol>
	<figure><img src="./img/car.jpg" alt="Driving directions to Reyeonk Clinic: search the Reyeonk Building parking lot or Sinsa-dong 662-12 in your navigation app, use valet parking at the lot, then walk diagonally to the Reyeonk Building. 5,000 KRW for the first 2 hours. Check in on the 3rd floor." width="460" height="2576"><figcaption>The text in this map is in Korean. The steps above describe the same route.</figcaption></figure>
</section>
</div>
