---js
const permalink = "/en/";
const lang = "en";
const title = "Reyeonk Clinic | Lifting and Skin Care in Apgujeong, Seoul";
const description = "16 years in practice, with doctors who personally handle everything from consultation to treatment. Ulthera Prime, Thermage FLX, Density, Potenza and skin boosters. About a 5-minute walk from Apgujeong Rodeo Station Exit 6. +82-2-558-5581.";
const alternates = [
	{ lang: "ko", url: "/" },
	{ lang: "en", url: "/en/" },
	{ lang: "ja", url: "/ja/" },
	{ lang: "x-default", url: "/" }
];
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Serif:wght@500;700&display=swap">
<style>
.rk {
	--rk-ink: #14211F;
	--rk-muted: #5A6B68;
	--rk-line: #D3DDDA;
	--rk-accent: #1D6B66;
	--rk-soft: #DDECE9;
	--rk-surface: #FFFFFF;
	--rk-display: "Noto Serif", Georgia, serif;
	--rk-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
	color: var(--rk-ink);
	font-family: var(--rk-body);
	font-size: 17px;
	line-height: 1.7;
	overflow-wrap: break-word;
}
@media (prefers-color-scheme: dark) {
	.rk {
		--rk-ink: #E4EEEC;
		--rk-muted: #9AAEAA;
		--rk-line: #273936;
		--rk-accent: #6CC3BB;
		--rk-soft: #1B3431;
		--rk-surface: #152322;
	}
}
.rk *, .rk *::before, .rk *::after { box-sizing: border-box; }
.rk h1, .rk h2, .rk h3 { font-family: var(--rk-display); font-weight: 700; line-height: 1.3; text-wrap: balance; margin: 0; }
.rk p { margin: 0; }
.rk a { color: var(--rk-accent); }

.rk-lang { font-size: 0.9rem; margin-bottom: 12px; }
.rk-hero { padding: 8px 0 8px; }
.rk-eyebrow { color: var(--rk-accent); font-weight: 600; font-size: 0.9rem; letter-spacing: 0.04em; }
.rk-hero h1 { font-size: clamp(1.7rem, 6vw, 2.5rem); margin-top: 10px; }
.rk-hero .rk-lead { margin-top: 16px; color: var(--rk-muted); max-width: 38rem; }
.rk-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
.rk-btn { display: inline-block; padding: 10px 20px; font-weight: 600; text-decoration: none; border: 1px solid var(--rk-accent); }
.rk-btn-main { background: var(--rk-accent); color: var(--rk-surface) !important; }
.rk-btn-sub { color: var(--rk-accent); }

.rk-points { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.rk-points li { background: var(--rk-soft); padding: 18px; }
.rk-points strong { display: block; font-family: var(--rk-display); font-size: 1.35rem; color: var(--rk-accent); }
.rk-points span { font-size: 0.95rem; }

.rk-section { margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--rk-line); }
.rk h2 { font-size: 1.4rem; margin-bottom: 18px; }
.rk-intro { color: var(--rk-muted); max-width: 38rem; margin-bottom: 20px; }

.rk-cats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.rk-cat { border: 1px solid var(--rk-line); padding: 18px; background: var(--rk-surface); }
.rk-cat h3 { font-size: 1.1rem; margin-bottom: 8px; }
.rk-cat ul { margin: 0; padding: 0; list-style: none; color: var(--rk-muted); font-size: 0.95rem; }
.rk-cat li + li { margin-top: 2px; }

.rk-info { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.rk-info dl { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px 18px; }
.rk-info dt { color: var(--rk-muted); font-size: 0.92rem; }
.rk-info dd { margin: 0; }
.rk-info h3 { font-size: 1.1rem; margin-bottom: 12px; }
.rk-note { margin-top: 10px; color: var(--rk-muted); font-size: 0.9rem; }

@media (max-width: 640px) {
	.rk { font-size: 16px; }
	.rk-points, .rk-cats, .rk-info { grid-template-columns: 1fr; }
}
</style>

<div class="rk">
	<p class="rk-lang"><a href="/" hreflang="ko" lang="ko">한국어</a> · <strong>English</strong></p>
	<section class="rk-hero">
		<p class="rk-eyebrow">LIFTING AND SKIN CARE CLINIC · APGUJEONG, SEOUL</p>
		<h1>A treatment plan drawn for your face,<br>by your doctor</h1>
		<p class="rk-lead">Reyeonk Clinic has been in practice for 16 years, since opening in 2009, without accidents. Our doctors personally handle everything one on one, from consultation and design to the treatment itself, and recommend plans tailored to your skin condition and facial structure.</p>
		<div class="rk-cta">
			<a class="rk-btn rk-btn-main" href="tel:+82-2-558-5581">Call +82-2-558-5581</a>
			<a class="rk-btn rk-btn-sub" href="/en/doctors/">Our doctors</a>
			<a class="rk-btn rk-btn-sub" href="https://reyeonk.co.kr" target="_blank" rel="noopener">Official website</a>
		</div>
		<ul class="rk-points">
			<li><strong>16 years</strong><span>Open since 2009, practicing without accidents</span></li>
			<li><strong>1:1</strong><span>Doctors personally handle everything from consultation to treatment</span></li>
			<li><strong>100%</strong><span>Genuine tips, as our standing rule</span></li>
		</ul>
	</section>

	<section class="rk-section">
		<h2>Treatments</h2>
		<div class="rk-cats">
			<div class="rk-cat">
				<h3>Lifting</h3>
				<ul>
					<li>Ulthera Prime</li>
					<li>Thermage FLX</li>
					<li>Density · Density Noir</li>
					<li>Onda · Shurink · InMode</li>
					<li>Virtue RF · Thread lifting</li>
				</ul>
			</div>
			<div class="rk-cat">
				<h3>Skin care</h3>
				<ul>
					<li>Potenza (pores, scars)</li>
					<li>Skin boosters · Rejuran Healer</li>
					<li>Melasma and pigmentation · Laser toning</li>
					<li>Acne and redness care</li>
					<li>Hair removal · Tattoo removal</li>
				</ul>
			</div>
			<div class="rk-cat">
				<h3>Petit and contouring</h3>
				<ul>
					<li>Premium fillers</li>
					<li>Botox · Skin Botox</li>
					<li>Volume design</li>
					<li>Facial contouring · Sunsak injection</li>
					<li>Liposuction</li>
				</ul>
			</div>
		</div>
		<p class="rk-note">Treatment plans are decided at an in-person consultation. Results and suitability differ from person to person.</p>
	</section>

	<section class="rk-section">
		<h2>Treatment guides</h2>
		<p class="rk-intro">Our detailed guides on how each treatment works, what to expect, and pricing are currently available in Korean only.</p>
		<p><a href="/blog/" hreflang="ko" lang="ko">Browse the guides (Korean)</a></p>
	</section>

	<section class="rk-section" id="info">
		<h2>Hours and Location</h2>
		<div class="rk-info">
			<div>
				<h3>Hours</h3>
				<dl>
					<dt>Mon · Tue · Thu</dt><dd>10:00 – 20:00</dd>
					<dt>Fri</dt><dd>10:00 – 19:00</dd>
					<dt>Sat</dt><dd>10:00 – 15:00</dd>
					<dt>Lunch break</dt><dd>13:00 – 14:00 (weekdays)</dd>
					<dt>Closed</dt><dd>Wednesdays · Sundays · Public holidays</dd>
				</dl>
			</div>
			<div>
				<h3>Getting here</h3>
				<dl>
					<dt>Address</dt><dd>Reyeonk Building, 64 Eonju-ro 172-gil, Gangnam-gu, Seoul<br>(Sinsa-dong 663-20), B1, 3F and 4F</dd>
					<dt>Subway</dt><dd>Suin-Bundang Line, Apgujeong Rodeo Station Exit 6, about a 5-minute walk</dd>
					<dt>Bus</dt><dd>Get off at the Galleria Department Store stop (143, 301, 362, 472 and others)</dd>
					<dt>Parking</dt><dd>Valet parking at the Reyeonk Building lot (Sinsa-dong 662-12), 5,000 KRW for the first 2 hours</dd>
					<dt>Phone</dt><dd><a href="tel:+82-2-558-5581">+82-2-558-5581</a></dd>
				</dl>
				<p class="rk-note">Please check in on the 3rd floor. <a href="/en/location/">Directions with photos</a></p>
			</div>
		</div>
	</section>
</div>

<script type="application/ld+json" eleventy:ignore>
{
	"@context": "https://schema.org",
	"@type": "MedicalClinic",
	"@id": "https://reyeonk2.com/#clinic",
	"name": "Reyeonk Clinic",
	"alternateName": ["ReYeonK Clinic", "리연케이의원"],
	"url": "https://reyeonk2.com/en/",
	"sameAs": ["https://reyeonk.co.kr"],
	"image": "https://reyeonk2.com/img/og/default.jpg",
	"description": "A lifting and skin care clinic in Apgujeong, Seoul, with 16 years in practice, where doctors personally handle everything from consultation to treatment.",
	"telephone": "+82-2-558-5581",
	"foundingDate": "2009",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "64 Eonju-ro 172-gil, Reyeonk Building",
		"addressLocality": "Gangnam-gu",
		"addressRegion": "Seoul",
		"addressCountry": "KR"
	},
	"openingHoursSpecification": [
		{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Thursday"], "opens": "10:00", "closes": "20:00" },
		{ "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "10:00", "closes": "19:00" },
		{ "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "15:00" }
	],
	"employee": [
		{ "@type": "Physician", "name": "Dr. Lee Doochan", "jobTitle": "Representative Director", "url": "https://reyeonk2.com/en/doctors/doochanlee/" },
		{ "@type": "Physician", "name": "Dr. Kim Hyunsu", "jobTitle": "Representative Director", "url": "https://reyeonk2.com/en/doctors/hyunsukim/" },
		{ "@type": "Physician", "name": "Dr. Choi Hyunho", "jobTitle": "Director", "url": "https://reyeonk2.com/en/doctors/hyunhochoi/" }
	],
	"availableService": [
		{ "@type": "MedicalProcedure", "name": "Ulthera Prime" },
		{ "@type": "MedicalProcedure", "name": "Thermage FLX" },
		{ "@type": "MedicalProcedure", "name": "Density" },
		{ "@type": "MedicalProcedure", "name": "Potenza" },
		{ "@type": "MedicalProcedure", "name": "Skin boosters" },
		{ "@type": "MedicalProcedure", "name": "Fillers" },
		{ "@type": "MedicalProcedure", "name": "Botox" }
	]
}
</script>
